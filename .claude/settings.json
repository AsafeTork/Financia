{
  "permissions": {
    "allow": [
      "Bash(npm run validate:fast)",
      "Bash(npm run validate:full)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(git diff)",
      "Bash(git status)",
      "Bash(git commit)",
      "Bash(git push)",
      "Bash(git add)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint .)",
      "Bash(npx vitest run)",
      "Bash(npx vite build)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git reset --hard)",
      "Bash(git rebase)",
      "Bash(rm -rf)",
      "Bash(rm -f .env*)",
      "Bash(rm -f package-lock.json)"
    ]
  }
}