# environments/.env.example
# Modelo para novas configurações de ambiente
# Copiar para .env.development.local, .env.staging ou .env.production

# Configurações Básicas
VITE_APP_NAME=Financia
VITE_APP_VERSION=1.0.0
VITE_API_URL=https://api.financia.app
VITE_ENV=development

# Configurações Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Configurações Stripe
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-key

# Configurações de Brand
VITE_BRAND_PRIMARY=#002f59
VITE_BRAND_SECONDARY:#ffffff
VITE_LOGO_URL=https://example.com/logo.png
