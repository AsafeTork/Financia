{
  "name": "gestao-financeira",
  "private": true,
  "version": "5.1.1",
  "sideEffects": false,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fast": "vitest run --no-isolate --reporter=dot",
    "test:changed": "vitest run --changed",
    "test:changed:watch": "vitest --changed",
    "lint": "eslint src/",
    "lint:changed": "node scripts/lint-changed.js",
    "typecheck": "tsc --noEmit --incremental",
    "typecheck:changed": "node scripts/typecheck-changed.js",
    "security:audit": "npm audit --audit-level=high",
    "analyze": "ANALYZE=true vite build",
    "check": "npm run lint && npm run typecheck && npm test",
    "validate:fast": "npm run lint:changed && npm run typecheck:changed && npm run test:changed",
    "validate:full": "npm run lint && npm run typecheck && npm test && npm run build",
    "audit:changed": "node scripts/audit-changed.js",
    "audit:full": "node scripts/audit-full.js",
    "validate:fast:js": "node scripts/validate-fast.js",
    "validate:full:js": "node scripts/validate-full.js",
    "audit:changed:js": "node scripts/audit-changed.js",
    "audit:full:js": "node scripts/audit-full.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.23",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^3.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/expect": "^4.1.10",
    "@vitest/spy": "^4.1.10",
    "@vitest/utils": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.0",
    "electron": "^43.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "nodemailer": "^9.0.3",
    "playwright": "^1.61.0",
    "postcss": "^8.4.47",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.14",
    "terser": "^5.49.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.4.10",
    "vitest": "^4.1.9",
    "vitest-dom": "^0.1.1"
  },
  "build": {
    "appId": "com.gestaofinanceira.app",
    "productName": "Financia",
    "files": [
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  }
}
